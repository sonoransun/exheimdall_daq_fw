# =============================================================================
# HeIMDALL DAQ Firmware - .gitignore
# =============================================================================

# --- C build outputs (Firmware/_daq_core, Firmware/_fpga_gateware) ---
*.o
*.d
*.out
*.so
*.a
*.gcda
*.gcno
Firmware/_daq_core/serial_test
Firmware/_fpga_gateware/build/

# --- Vendored copy-in dependencies (copied into _daq_core before building,
# --- see CLAUDE.md; NE10*.h headers ARE tracked - only the copy-ins are not)
Firmware/_daq_core/rtl-sdr.h
Firmware/_daq_core/rtl-sdr_export.h
Firmware/_daq_core/librtlsdr.a
Firmware/_daq_core/libNE10.a
Firmware/_daq_core/libkfr_capi.so*
Firmware/_daq_core/kfr/

# --- CI dependency cache (ci/build.sh) ---
.ci-deps/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
.venv/
venv/
.pytest_cache/

# --- Runtime state: logs (keep the 'logs' legend file), PID files, archives ---
Firmware/_logs/*
!Firmware/_logs/logs
Firmware/_testing/test_logs/*
Firmware/_testing/benchmark_results/

# --- Runtime state: control files, FIFOs, hardware caps, FIR coefficients ---
Firmware/_data_control/*
!Firmware/_data_control/.gitkeep

# --- Runtime state: BerkeleyDB telemetry ---
Firmware/_db/*
!Firmware/_db/.gitkeep

# --- Editors / OS noise ---
.DS_Store
*.swp
*~
